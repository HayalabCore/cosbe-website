{
  "name": "cosbe-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/with-env.ts next dev",
    "dev:prod": "APP_ENV=production tsx scripts/with-env.ts next dev",
    "dev:staging": "APP_ENV=staging tsx scripts/with-env.ts next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:staging": "APP_ENV=staging tsx scripts/confirm-remote.ts && APP_ENV=staging prisma migrate deploy",
    "db:deploy:prod": "APP_ENV=production tsx scripts/confirm-remote.ts && APP_ENV=production prisma migrate deploy",
    "db:status:staging": "APP_ENV=staging prisma migrate status",
    "db:status:prod": "APP_ENV=production prisma migrate status",
    "db:bootstrap-admins:staging": "APP_ENV=staging tsx scripts/bootstrap-admin-users.ts",
    "db:bootstrap-admins:prod": "APP_ENV=production tsx scripts/bootstrap-admin-users.ts",
    "db:pull-translations:prod": "APP_ENV=production tsx scripts/pull-translations.ts",
    "db:sync-translations:prod": "APP_ENV=production tsx scripts/sync-translations.ts",
    "db:push-translations:prod": "APP_ENV=production tsx scripts/push-translations.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "import-article": "tsx scripts/import-article.ts",
    "capture-fixture": "tsx scripts/capture-fixture.ts",
    "db:seed-translations": "tsx scripts/seed-translations.ts",
    "db:pull-translations": "tsx scripts/pull-translations.ts",
    "db:push-translations": "tsx scripts/push-translations.ts",
    "db:sync-translations": "tsx scripts/sync-translations.ts",
    "db:bootstrap-admins": "tsx scripts/bootstrap-admin-users.ts",
    "db:local-super-admin": "tsx scripts/grant-local-super-admin.ts",
    "test": "vitest run --project unit --project component",
    "test:watch": "vitest --project unit --project component",
    "test:db": "vitest run --project db",
    "secrets:push:staging": "bash scripts/push-secrets.sh staging",
    "secrets:push:prod": "bash scripts/push-secrets.sh production",
    "worker:dev": "tsx watch worker/main.ts",
    "worker:start": "tsx worker/main.ts",
    "worker:staging": "APP_ENV=staging STUDIO_WORKER_ALLOW_REMOTE=1 tsx worker/main.ts",
    "worker:deploy:staging": "bash scripts/deploy-worker.sh staging",
    "worker:deploy:prod": "bash scripts/deploy-worker.sh production",
    "worker:status": "bash scripts/worker-ctl.sh status",
    "worker:logs": "bash scripts/worker-ctl.sh logs",
    "worker:tail": "bash scripts/worker-ctl.sh tail",
    "worker:up": "bash scripts/worker-ctl.sh up",
    "worker:down": "bash scripts/worker-ctl.sh down",
    "worker:restart": "bash scripts/worker-ctl.sh restart",
    "worker:schedule": "bash scripts/schedule-worker.sh",
    "test:translations-flatten": "tsx src/lib/translations/flatten.roundtrip.test.ts",
    "prepare": "husky",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.101",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.8.0",
    "@prisma/client": "6.19.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "ai": "^7.0.150",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "openai": "^6.46.0",
    "pg-boss": "^12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
