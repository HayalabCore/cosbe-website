# Prisma (Supabase: use pooled URL for DATABASE_URL, session/direct for DIRECT_URL)
# Database Configuration
DATABASE_URL=
DIRECT_URL=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Supabase dashboard → Project Settings → API Keys → secret key
# (`sb_secret_...`). Same privilege as the old service_role JWT. Used to
# create/disable/delete admin users and by `yarn db:bootstrap-admins`.
# Never prefix with NEXT_PUBLIC_. Same name in App Hosting env as DATABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=
# Password reset and disable DELETE from auth.sessions. The DATABASE_URL role
# must be allowed to do that (the default Supabase postgres user is).
# Confirm with (0 rows is success):
#   DELETE FROM auth.sessions WHERE user_id = '00000000-0000-0000-0000-000000000000';

# HubSpot Configuration
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_FORM_ID_EN=
NEXT_PUBLIC_HUBSPOT_FORM_ID_JA=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# External API (POST /api/articles — Authorization: Bearer <key>)
API_SECRET_KEY=
