# Template for .env.local (this machine) and env/<staging|production>.env.
# Which file a command reads is chosen by APP_ENV; see env/README.md.
# Deployed services use platform variables, not files.

# Database. Local: one URL (DIRECT_URL falls back to it for localhost).
# Supabase: DATABASE_URL = transaction pooler (:6543, ?pgbouncer=true),
# DIRECT_URL = session pooler (:5432, needed by migrations and pg-boss).
DATABASE_URL=
DIRECT_URL=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Supabase dashboard → Project Settings → API Keys → secret key
# (`sb_secret_...`). Same privilege as the old service_role JWT. Used to
# create/disable/delete admin users and by `yarn db:bootstrap-admins`.
# Never prefix with NEXT_PUBLIC_. Same name in App Hosting env as DATABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=
# Password reset and disable DELETE from auth.sessions. The DATABASE_URL role
# must be allowed to do that (the default Supabase postgres user is).
# Confirm with (0 rows is success):
#   DELETE FROM auth.sessions WHERE user_id = '00000000-0000-0000-0000-000000000000';

# HubSpot Configuration
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_FORM_ID_EN=
NEXT_PUBLIC_HUBSPOT_FORM_ID_JA=

# Google Analytics 4 (public pages only). Leave empty locally/staging to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Deployed staging only: SITE_ENV=staging makes the site noindex
# (X-Robots-Tag header + robots.txt). Leave unset everywhere else.
# SITE_ENV=

# External API (POST /api/articles — Authorization: Bearer <key>)
API_SECRET_KEY=

# Content Studio worker (worker/main.ts, separate Cloud Run service)
# The worker uses DATABASE_URL (append &connection_limit=3 in production) and
# DIRECT_URL (session pooler :5432 — required by pg-boss). The website also
# uses DIRECT_URL for its one-connection pg-boss pool (src/lib/studio/web-boss.ts).
# Optional overrides:
# PORT=8080
# STUDIO_WORKER_ID=
# Model per task, "<provider>:<model-id>". Set to current OpenAI model ids:
# STUDIO_MODEL_OUTLINE=
# STUDIO_MODEL_WRITE=
# STUDIO_MODEL_REPAIR=
# STUDIO_MODEL_AGENT=
# STUDIO_MODEL_DIGEST=
# STUDIO_MODEL_TRANSLATE=
# STUDIO_MODEL_FINISH=
# STUDIO_MODEL_EMBED=
# Token ceiling per generation run (ingest runs scale with the source size).
# STUDIO_RUN_TOKEN_CEILING=400000
# `yarn worker:dev` refuses a remote database unless this is 1.
# STUDIO_WORKER_ALLOW_REMOTE=
